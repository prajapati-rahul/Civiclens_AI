# CivicLens AI — Root Environment Configuration Example
# Copy this to backend/.env or use as reference

# Google Gemini API key (optional — deterministic fallback mode works without any key)
GEMINI_API_KEY=

# Persistent SQLite database location
DATABASE_URL=sqlite:///./civiclens.db

# Frontend CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Audit bounds and safety envelopes
MAX_PAGES_PER_AUDIT=5
AUDIT_TIMEOUT_SECONDS=120
