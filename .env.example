# CivicLens AI — Environment Configuration Example
# Copy this file to backend/.env

# xAI (Grok) API Key (recommended)
XAI_API_KEY=
XAI_MODEL=grok-2-latest

# Google Gemini API key (optional alternative)
GEMINI_API_KEY=

# Database Configuration (Supports both SQLite and MongoDB):
# Option 1: SQLite (default, zero-setup embedded file)
DATABASE_URL=sqlite:///./civiclens.db

# Option 2: MongoDB (local instance or MongoDB Atlas cluster)
# DATABASE_URL=mongodb://localhost:27017/civiclens
# DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/civiclens?retryWrites=true&w=majority

# Frontend CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Audit bounds and safety envelopes
MAX_PAGES_PER_AUDIT=5
AUDIT_TIMEOUT_SECONDS=120
