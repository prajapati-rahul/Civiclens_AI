# xAI (Grok) API Key (set your key here to use Grok for AI auditing)
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-2-latest

# Google Gemini API Key (optional alternative)
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration (Supports both SQLite and MongoDB):
# Option A: SQLite (default, zero setup needed)
DATABASE_URL=sqlite:///./civiclens.db
# Option B: MongoDB (local or Atlas cloud cluster)
# DATABASE_URL=mongodb://localhost:27017/civiclens
# DATABASE_URL=mongodb+srv://<user>:<password>@cluster0.mongodb.net/civiclens?retryWrites=true&w=majority

# Frontend CORS origins
CORS_ORIGINS=http://localhost:5173

# Audit safety limits
MAX_PAGES_PER_AUDIT=5
AUDIT_TIMEOUT_SECONDS=120
